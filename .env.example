# ====================== PostgreSQL Database ======================
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# ====================== Redis ======================
# Redis doesn't use env vars in this compose, but we can add for future use
REDIS_HOST=redis
REDIS_PORT=6379

# ====================== Web Server ======================
# Port for Nginx
HTTP_PORT=8000

# ====================== Monitoring Ports (Reference) ======================
# These are exposed ports - you can change them if needed
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001

# ====================== Postgres Exporter ======================
# Used by postgres-exporter service
# (Currently hardcoded in docker-compose, but good to document)
POSTGRES_EXPORTER_DATA_SOURCE="postgresql://laravel:secret@db:5432/laravel?sslmode=disable"

# ====================== Redis Exporter ======================
# Used by redis-exporter service
REDIS_EXPORTER_ADDR="redis://redis:6379"